# ─── HERA backend config ───────────────────────────────────────────────
# Copy to ".env" for your own reference, but note the caveat below.
#
# ⚠️  HERA does NOT auto-load .env files. `dotenv` is a dependency but is
#     never imported, so these values only take effect if they are set in
#     the real environment. docker-compose.yml sets them via `environment:`.
#     Running bare, use:  LOCAL_AI_MODEL=llama3.1:8b npm start
#
# These four are the ONLY variables the code reads. Everything else —
# providers, API keys, appearance, system prompt — is configured in the web
# UI and persisted to settings.json in the data directory.

# Port the backend listens on.
PORT=8787

# Where settings.json is written. Under Docker this is the hera-data volume.
# HERA_DATA_DIR=./data

# ─── Default local provider ───
# Only used to seed settings.json on FIRST run, before a settings file
# exists. Afterwards the UI is the single source of truth and these are
# ignored. Note the /v1 suffix — the API is OpenAI-compatible.
LOCAL_AI_BASE_URL=http://YOUR-OLLAMA-HOST:11434/v1
LOCAL_AI_MODEL=qwen2.5:14b

# ─── Cloud fallback ───
# There is no environment variable for this. Add cloud providers in
# Settings → AI Providers and give them a higher priority number than the
# local one; the router tries providers in ascending priority order and
# falls through to the next when one fails.
#
# Never commit real keys — backend/data/ is gitignored for this reason.
